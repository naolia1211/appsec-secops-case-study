FROM docker:27.3.1-cli
RUN apk add --no-cache bash curl python3 py3-yaml
ARG K3D_VERSION=v5.8.3
ARG KUBECTL_VERSION=v1.32.5
RUN arch="$(uname -m)"; case "$arch" in x86_64) arch=amd64 ;; aarch64) arch=arm64 ;; *) exit 1 ;; esac;     curl -fsSL "https://github.com/k3d-io/k3d/releases/download/${K3D_VERSION}/k3d-linux-${arch}" -o /tmp/k3d-linux-${arch} &&     curl -fsSL "https://github.com/k3d-io/k3d/releases/download/${K3D_VERSION}/checksums.txt" -o /tmp/checksums.txt &&     cd /tmp && grep " _dist/k3d-linux-${arch}$" checksums.txt | sed "s|_dist/||" | sha256sum -c - &&     mv k3d-linux-${arch} /usr/local/bin/k3d && chmod +x /usr/local/bin/k3d &&     curl -fsSL "https://dl.k8s.io/release/${KUBECTL_VERSION}/bin/linux/${arch}/kubectl" -o /usr/local/bin/kubectl &&     curl -fsSL "https://dl.k8s.io/release/${KUBECTL_VERSION}/bin/linux/${arch}/kubectl.sha256" -o /tmp/kubectl.sha256 &&     printf '%s  /usr/local/bin/kubectl\n' "$(cat /tmp/kubectl.sha256)" | sha256sum -c - &&     chmod +x /usr/local/bin/kubectl
WORKDIR /workspace
ENTRYPOINT ["bash", "scripts/k8s/lab.sh"]
